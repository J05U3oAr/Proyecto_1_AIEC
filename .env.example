NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Alternativa gratuita para selección manual:
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Backend local. Compose usa Redis y nombres MCP internos por defecto.
REDIS_URL=redis://localhost:6379/0
MOVIES_MCP_URL=http://localhost:8001/mcp
BOOKS_MCP_URL=http://localhost:8002/mcp
# Compose usa destinos internos distintos del loopback del host. Override opcional:
# MOVIES_MCP_CONTAINER_URL=http://movies:8001/mcp
# BOOKS_MCP_CONTAINER_URL=http://books:8002/mcp
# Obligatorio también para el MCP local. Generar un valor aleatorio; nunca VITE_*.
MCP_TOKEN=
ALLOWED_ORIGINS=["http://localhost:3000"]

SESSION_TTL=1800
MAX_HISTORY=20
MAX_LLM_CALLS=4
MAX_TOOL_CALLS=6
MAX_OUTPUT_TOKENS=2048
TURN_TIMEOUT=60
PROVIDER_TIMEOUT=15
# Presupuesto interno del curso; no equivale a cuota contractual del proveedor.
LLM_DAILY_BUDGET=1000
REQUEST_BODY_LIMIT=16384

# TMDB: API Read Access Token, sin prefijo Bearer. Registro CC3116/UVG no comercial.
TMDB_READ_TOKEN=
TMDB_DAILY_BUDGET=1000
CATALOG_CACHE_TTL=3600
TMDB_TIMEOUT=5
TMDB_RETRIES=1
MOVIES_ALLOWED_HOSTS=["localhost","localhost:*","127.0.0.1","127.0.0.1:*","movies:8001"]

# Desarrollo frontend: mock conserva fase 1; real evita iniciar MSW.
VITE_CHAT_MODE=mock
