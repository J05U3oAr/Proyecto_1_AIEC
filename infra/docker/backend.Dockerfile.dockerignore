# Build from an allowlist: credentials and local development files never enter it.
**
!server/
!infra/
!infra/docker/
!infra/docker/backend.Dockerfile
!server/pyproject.toml
!server/uv.lock
!server/sofia/
!server/sofia/*.py
!shared/
!shared/contracts/
!shared/contracts/**

# Keep these exclusions last, including inside otherwise allowed directories.
**/.env
**/.env.*
**/__pycache__/
**/*.pyc
