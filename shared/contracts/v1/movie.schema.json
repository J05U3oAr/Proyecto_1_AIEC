{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "exclusiveMinimum": 0,
      "title": "Id",
      "type": "integer"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "year": {
      "anyOf": [
        {
          "maximum": 2200,
          "minimum": 1800,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Year"
    },
    "overview": {
      "default": "",
      "maxLength": 4000,
      "title": "Overview",
      "type": "string"
    },
    "poster": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Poster"
    },
    "tmdb": {
      "title": "Tmdb",
      "type": "string"
    },
    "imdb": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Imdb"
    },
    "genres": {
      "items": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Genres",
      "type": "array"
    },
    "runtime": {
      "anyOf": [
        {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime"
    },
    "tmdbRating": {
      "anyOf": [
        {
          "maximum": 10,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tmdbrating"
    },
    "voteCount": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Votecount"
    }
  },
  "required": [
    "id",
    "title",
    "tmdb"
  ],
  "title": "Movie",
  "type": "object"
}
